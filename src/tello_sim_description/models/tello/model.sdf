          <diffuse>0.025 0.033 0.045 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr>
            <metal>
              <metalness>0.0</metalness>
              <roughness>0.32</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 0 .002 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0038</radius>
            <length>0.0035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.13 0.15 0.18 1</ambient>
          <diffuse>0.13 0.15 0.18 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr>
            <metal>
              <metalness>0.25</metalness>
              <roughness>0.45</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="hub_cap">
        <pose>0 0 .002 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0014</radius>
            <length>0.0038</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.48 0.52 0.56 1</ambient>
          <diffuse>0.48 0.52 0.56 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr>
            <metal>
