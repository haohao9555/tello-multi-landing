    </plugin>

    <plugin filename="gz-sim-multicopter-control-system" name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>tello</robotNamespace>
      <commandSubTopic>gazebo/command/twist</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>base_link</comLinkName>

      <velocityGain>0.2 0.2 0.2</velocityGain>

      <attitudeGain>0.0288 0.0316 0.0013</attitudeGain>
      <angularRateGain>0.00216 0.00237 0.00078</angularRateGain>
      <maximumLinearAcceleration>3 3 3</maximumLinearAcceleration>
      <maximumLinearVelocity>8 8 2</maximumLinearVelocity>
      <maximumAngularVelocity>3 3 1.5</maximumAngularVelocity>
      <rotorConfiguration>
        <rotor>
          <jointName>rotor_0_joint</jointName>
          <forceConstant>4.36e-08</forceConstant>
          <momentConstant>0.01</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_1_joint</jointName>
          <forceConstant>4.36e-08</forceConstant>
          <momentConstant>0.01</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_2_joint</jointName>
          <forceConstant>4.36e-08</forceConstant>
          <momentConstant>0.01</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_3_joint</jointName>
          <forceConstant>4.36e-08</forceConstant>
          <momentConstant>0.01</momentConstant>
          <direction>-1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_topic>/model/tello/odometry</odom_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </model>
